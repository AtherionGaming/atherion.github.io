<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<title>Atherion Gaming Galéria</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&display=swap" rel="stylesheet">
<style>
body{margin:0;font-family:Arial;background-image:url('https://metin2.download/picture/UOIXWBG4d1PsC0Bjiga6EHj4c380szxg/.jpg');background-size:cover;color:white;}
.header{text-align:center;font-family:'Cinzel';font-size:50px;color:#00cfff;text-shadow:0 0 20px #00cfff;margin:20px 0;}
.content{padding:20px;display:flex;flex-direction:column;align-items:center;}
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;width:100%;max-width:900px;margin-top:20px;}
.gallery img{width:100%;height:120px;object-fit:cover;border-radius:8px;border:2px solid #00cfff;}
.upload-form{display:flex;flex-direction:column;gap:10px;width:100%;max-width:300px;margin-bottom:20px;}
.upload-form input, .upload-form button{padding:8px;border-radius:6px;border:2px solid #00cfff;background:#001a26;color:#00eaff;font-family:'Cinzel';}
.upload-form button{cursor:pointer;}
</style>
</head>
<body>

<div class="header">Atherion Gaming Galéria</div>
<div class="content">
  <form class="upload-form">
    <label>Kép kiválasztása:</label>
    <input type="file" accept="image/*" id="imgInput" required>
    <label>Dátum:</label>
    <input type="date" id="uploadDate" required>
    <label>Feltöltő neve:</label>
    <input type="text" id="uploaderName" required>
    <button type="button" onclick="uploadImage()">Feltöltés</button>
  </form>
  <div id="galleryContainer" class="gallery"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.30.0/dist/supabase.min.js"></script>
<script>
// Supabase init
const SUPABASE_URL = "https://stdlzcitdmapnsulqmdi.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN0ZGx6Y2l0ZG1hcG5zdWxxbWRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQyNzA3OTksImV4cCI6MjA4OTg0Njc5OX0.xHbj4beiQR18X8QWraKPYT5DuslIUag-PM8zI14l0JA";
const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

// Current folder (külön Magic / Mystic lehet, itt default "general")
const currentFolder = "general";

// Load gallery on page load
document.addEventListener("DOMContentLoaded", ()=>{loadGallery();});

// --- LOAD GALLERY ---
async function loadGallery(){
  const container = document.getElementById("galleryContainer");
  container.innerHTML = "<p>Betöltés...</p>";

  const { data, error } = await supabase.storage.from('gallery').list(currentFolder+'/');
  if(error){container.innerHTML="<p>Hiba a galéria betöltésekor.</p>"; console.error(error); return;}

  let html = '';
  for(let file of data){
    const { data: urlData } = supabase.storage.from('gallery').getPublicUrl(currentFolder+'/'+file.name);
    html += `<img src="${urlData.publicUrl}">`;
  }
  container.innerHTML = html;
}

// --- UPLOAD IMAGE ---
async function uploadImage(){
  const fileInput = document.getElementById("imgInput");
  const dateInput = document.getElementById("uploadDate").value;
  const nameInput = document.getElementById("uploaderName").value;

  if(!fileInput.files[0] || !dateInput || !nameInput){alert("Tölts ki minden mezőt!"); return;}

  const file = fileInput.files[0];
  const fileName = `${Date.now()}_${file.name}`;

  const { error } = await supabase.storage.from('gallery').upload(currentFolder+'/'+fileName, file);
  if(error){alert("Hiba a feltöltés során!"); console.error(error); return;}
  alert("Feltöltés sikeres!");
  loadGallery();
}
</script>
</body>
</html>
